{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
"logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/logo/logo.png",
    "width": 20,
    "height": 10,
    //"position": "top",
    // "padding": {
    //     "top": 1,
    //     "left": 0,
    //     "right": 0
    // }
},
    "display": {
        "separator": "  ",
        "color": "white"
    },

    "modules": [
        "break",
        {
            "type": "custom",
            "key": "╭─────────────────────────────────────────╮"
        },
  // {
  //           "type": "command",
  //           "key": " ",
  //           "shell": "/bin/bash",
  //           "text": "echo '│              offluencer.com             │'",
  //           "format": "{1}"
  //       },
        {
            "type": "custom",
            "key": "│                                         │"
        },
         {
            "type": "os",
            "key": "│  OS           ",
            "format": "{pretty-name>22}  │"
        },
        {
            "type": "command",
            "key": "│  Kernel       ",
            "text": "uname -r | cut -d '-' -f1",
            "format": "{>22}  │"
        },
        {
            "type": "shell",
            "key": "│  Shell        ",
            "format": "{pretty-name>22}  │"
        },
        {
            "type": "command",
            "key": "│  WM           ",
            "text": "echo $XDG_CURRENT_DESKTOP",
            "format": "{>22}  │"
        },
        {
            "type": "packages",
            "key": "│  Packages     ",
            "format": "{all>22}  │"
        },
        {
            "type": "custom",
            "key": "│                                         │"
        },
      
        {
            "type": "custom",
            "key": "╰─────────────────────────────────────────╯"
        },
        "break"
    ]
}
